# OpenAI (required for CV profiling and AI recommendations)
OPENAI_API_KEY=
PAPERPULSE_ANALYSIS_MODEL=gpt-5.6-luna
PAPERPULSE_EMBEDDING_MODEL=text-embedding-3-small
# Optional display-only estimate; update these when your chosen model pricing changes.
PAPERPULSE_EST_INPUT_USD_PER_MILLION=1.0
PAPERPULSE_EST_OUTPUT_USD_PER_MILLION=6.0

# Optional, and good manners. Crossref and OpenAlex serve identified clients from
# a "polite" pool with higher rate limits. Abstract lookups are batched by DOI and
# already stay inside the anonymous limits, so this mainly buys headroom on large
# refreshes and a contact point if a service needs to reach you.
PAPERPULSE_CONTACT_EMAIL=

# Optional: casual OpenAlex searches work without a key; a free key raises the quota.
OPENALEX_API_KEY=

# Optional, and the only way to reach Elsevier/ScienceDirect abstracts. Elsevier
# deposits no abstracts to Crossref, had them removed from OpenAlex, and blocks
# automated page requests, so Scopus is the sole remaining route. Register a free
# key at https://dev.elsevier.com/. Returning the abstract requires an entitled
# institution: run PaperPulse from the campus network, or ask your librarian for
# an institution token for off-site use. Without entitlement these calls return
# nothing and PaperPulse falls back to an excerpt.
ELSEVIER_API_KEY=
ELSEVIER_INSTTOKEN=

# Inoreader OAuth 2.0 (read-only)
# Register a local OAuth app and use this exact redirect URI:
# http://localhost:8000/api/inoreader/callback
INOREADER_CLIENT_ID=
INOREADER_CLIENT_SECRET=
INOREADER_REDIRECT_URI=http://localhost:8000/api/inoreader/callback

# Local app settings
PAPERPULSE_FRONTEND_URL=http://localhost:3000
PAPERPULSE_DATA_DIR=./data
PAPERPULSE_DEMO_MODE=true

# Public publisher abstracts: render Inoreader links in a persistent local Chrome
# profile before falling back to scholarly metadata APIs. If a publisher presents a
# verification page, PaperPulse can open that profile visibly for manual completion.
PAPERPULSE_BROWSER_ABSTRACTS=true
PAPERPULSE_BROWSER_HEADLESS=true
PAPERPULSE_BROWSER_TIMEOUT_MS=12000

# Optional: set this to keep the encryption key outside ./data.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAPERPULSE_ENCRYPTION_KEY=
