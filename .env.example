# OpenAI (required for CV profiling and AI recommendations)
OPENAI_API_KEY=
PAPERPULSE_ANALYSIS_MODEL=gpt-5.6-luna
PAPERPULSE_EMBEDDING_MODEL=text-embedding-3-small

# Inoreader OAuth 2.0 (read-only)
# Register a local OAuth app and use this exact redirect URI:
# http://localhost:8000/api/inoreader/callback
INOREADER_CLIENT_ID=
INOREADER_CLIENT_SECRET=
INOREADER_REDIRECT_URI=http://localhost:8000/api/inoreader/callback

# Local app settings
PAPERPULSE_FRONTEND_URL=http://localhost:3000
PAPERPULSE_DATA_DIR=./data
PAPERPULSE_DEMO_MODE=true

# Optional: set this to keep the encryption key outside ./data.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAPERPULSE_ENCRYPTION_KEY=
